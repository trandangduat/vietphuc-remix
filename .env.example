# Supabase Configuration
# Tạo project miễn phí tại https://supabase.com
# Lấy URL và Anon Key tại Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pollinations AI Configuration (Tùy chọn - không bắt buộc)
# Mặc định hệ thống hoạt động tự do. Bạn có thể lấy API Key miễn phí không cần thẻ tại:
# https://enter.pollinations.ai/keys
VITE_POLLINATIONS_API_KEY=

# Groq — Bé Cáo chấm điểm outfit theo ảnh preview và sự kiện
# Lấy key tại https://console.groq.com/keys
# Key này chỉ chạy trên dev server, không đưa vào bundle trình duyệt.
GROQ_API_KEY=
# Model đa phương thức. Mặc định là qwen/qwen3.8-27b
GROQ_MODEL=qwen/qwen3.8-27b
